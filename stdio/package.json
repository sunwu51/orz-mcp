{
  "name": "orz-mcp",
  "version": "1.0.1",
  "description": "MCP server with web_search and web_fetch tools. Searches DuckDuckGo with deduplication. Supports HTTP proxy for users behind firewalls.",
  "main": "client.mjs",
  "bin": {
    "orz-mcp": "client.mjs"
  },
  "scripts": {
    "start": "node client.mjs"
  },
  "keywords": [
    "mcp",
    "web-search",
    "web-fetch",
    "proxy",
    "stdio",
    "model-context-protocol"
  ],
  "author": "sunwu51",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunwu51/orz-mcp.git"
  },
  "homepage": "https://github.com/sunwu51/orz-mcp#readme",
  "bugs": {
    "url": "https://github.com/sunwu51/orz-mcp/issues"
  },
  "type": "module",
  "files": [
    "client.mjs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.22.0"
  }
}
